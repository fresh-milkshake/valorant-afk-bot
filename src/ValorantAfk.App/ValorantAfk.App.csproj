<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <AssemblyName>ValorantAfkBot</AssemblyName>
    <RootNamespace>ValorantAfkBot.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ValorantAfk.Core\ValorantAfk.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\ValorantAfk.Windows\**\*.cs" Exclude="..\ValorantAfk.Windows\bin\**\*.cs;..\ValorantAfk.Windows\obj\**\*.cs" Link="Windows\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="OpenTK" Version="4.9.3" />
    <PackageReference Include="OpenTK.GLControl" Version="4.0.2" />
  </ItemGroup>
</Project>
